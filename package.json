{
  "name": "buzz-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build && node scripts/build/assert-no-dev-login.mjs",
    "check": "eslint . && tsc --noEmit",
    "db:baseline": "bunx prisma migrate resolve --applied 0_init",
    "db:format": "prisma format",
    "db:generate": "bunx prisma generate",
    "db:migrate": "bunx prisma migrate dev",
    "db:migrate:deploy": "bunx prisma migrate deploy",
    "db:migrate:status": "bunx prisma migrate status",
    "db:push": "prisma db push",
    "db:studio": "bunx prisma studio",
    "db:validate": "prisma validate",
    "dev": "next dev --turbo",
    "format": "prettier --write .",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "k6": "k6",
    "k6:build": "bun run scripts/k6/build.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "load": "BUN_CONFIG_MAX_HTTP_REQUESTS=65000 bun run scripts/load/run.ts",
    "ops:backup-rehearsal": "bun run scripts/ops/backup-rehearsal.ts",
    "ops:cleanup": "bun run scripts/ops/cleanup.ts",
    "ops:verify-restore": "bun run scripts/ops/verify-restore.ts",
    "postinstall": "bun db:generate",
    "preview": "bun run build && next start",
    "prod:db:migrate": "bun --env-file=.env.production run db:migrate:deploy",
    "start": "next start",
    "test": "vitest run --project unit --project component",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --project integration",
    "test:services:down": "docker compose --file ./docker-compose.test.yml down --volumes",
    "test:services:up": "docker compose --file ./docker-compose.test.yml up --detach --wait",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "vercel:env:pull": "bunx vercel env pull .env.production"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "^11.22.1",
    "@trpc/react-query": "^11.22.1",
    "@trpc/server": "^11.22.1",
    "@types/event-source-polyfill": "^1.0.5",
    "@types/lodash": "^4.17.27",
    "@types/luxon": "^3.7.6",
    "@types/qrcode": "^1.5.6",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookies-next": "^5.1.0",
    "event-source-polyfill": "^1.0.31",
    "input-otp": "^1.5.0",
    "lodash": "^4.18.1",
    "lucide-react": "^0.488.0",
    "luxon": "^3.7.2",
    "neverthrow": "^8.2.0",
    "next": "^16.4.3",
    "next-auth": "5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "redis": "^4.7.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "tslog": "^4.11.0",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@esbuild-plugins/tsconfig-paths": "^0.1.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/k6": "^1.7.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-neverthrow": "^1.1.4",
    "jsdom": "^30.1.3",
    "k6": "^0.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
