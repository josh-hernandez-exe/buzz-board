// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games          Game[]
  accounts       Account[]
  sessions       Session[]
  gameUsers      GameUser[]
  gameAdmin      GameAdmin[]
  gameOperations GameOperation[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum GameFormat {
  individual
  team
}

model Game {
  id                String     @id @default(cuid())
  name              String
  code              String     @unique @db.VarChar(6)
  isBuzzerListening Boolean    @default(false)
  data              Json       @default("{}")
  settings          Json       @default("{}")
  format            GameFormat @default(team)

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameUsers        GameUser[]
  gameTeams        GameTeam[]
  gameAdmins       GameAdmin[]
  scoreboard       Scoreboard?
  scoreboardStates ScoreboardState[]
  operations       GameOperation[]
  scoreEffects     ScoreEffect[]
}

model GameUser {
  id         String  @id @default(cuid())
  name       String
  index      Int
  gameId     String
  gameTeamId String?
  userId     String?
  token      String  @unique
  data       Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id])
  game     Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameTeam GameTeam? @relation(fields: [gameTeamId], references: [id], onDelete: Cascade)
}

enum BuzzerState {
  available
  selected
  rejected
}

model GameTeam {
  id          String      @id @default(cuid())
  index       Int
  name        String
  gameId      String
  buzzerState BuzzerState @default(available)
  data        Json        @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  game      Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameUsers GameUser[]

  @@unique([gameId, index])
}

model GameAdmin {
  id       String @id @default(cuid())
  userId   String
  gameId   String
  settings Json   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model ScoreboardState {
  id           String @id @default(cuid())
  gameId       String
  scoreboardId String
  state        Json   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  scoreboard       Scoreboard  @relation("AllScoreboardStates", fields: [scoreboardId], references: [id], onDelete: Cascade)
  activeScoreboard Scoreboard?
  game             Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model Scoreboard {
  id     String @id @default(cuid())
  gameId String @unique

  currentStateId String? @unique
  pastStateIds   Json    @default("[]")
  futureStateIds Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  game         Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  allStates    ScoreboardState[] @relation("AllScoreboardStates")
  currentState ScoreboardState?  @relation(fields: [currentStateId], references: [id])
}

/// Receipt for one committed game command. A retry with the same requestId by
/// the same actor and payload returns `result` instead of applying it again.
/// This is audit/idempotency storage, not an event log or a second score total.
model GameOperation {
  id          String   @id @default(cuid())
  gameId      String
  requestId   String   @db.VarChar(64)
  action      String   @db.VarChar(64)
  actorUserId String?
  /// SHA-256 of the canonical command payload.
  payloadHash String   @db.VarChar(64)
  /// Small committed-result summary returned to retries; never bodies or tokens.
  result      Json     @default("{}")
  createdAt   DateTime @default(now())

  game         Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  actorUser    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  scoreEffects ScoreEffect[]

  @@unique([gameId, requestId])
  @@index([gameId, createdAt])
}

/// Immutable evidence of the score change an operation actually applied to one
/// scoring unit. Current scores still come only from the Scoreboard's current
/// state; these rows are never summed to produce a total.
model ScoreEffect {
  id                String   @id @default(cuid())
  gameId            String
  operationId       String
  /// The scoring unit (team, or an individual's backing team). Intentionally
  /// not a foreign key: evidence must survive the team being removed.
  gameTeamId        String
  /// Float (double precision) so legacy fractional balances are recorded
  /// exactly; new inputs are bounded integers, which doubles represent exactly.
  delta             Float
  scoreBefore       Float
  scoreAfter        Float
  /// The scoreboard state that was current after the operation.
  scoreboardStateId String
  createdAt         DateTime @default(now())

  game      Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  operation GameOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, gameTeamId])
  @@index([gameId, gameTeamId, createdAt])
}
