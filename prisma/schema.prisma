// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games     Game[]
  accounts  Account[]
  sessions  Session[]
  gameUsers GameUser[]
  gameAdmin GameAdmin[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum GameFormat {
  single
  team
}

model Game {
  id                String     @id @default(cuid())
  name              String
  code              String     @unique @db.VarChar(6)
  isBuzzerListening Boolean    @default(false)
  data              Json       @default("{}")
  settings          Json       @default("{}")
  format            GameFormat @default(team)

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameUsers        GameUser[]
  gameTeams        GameTeam[]
  gameAdmins       GameAdmin[]
  scoreboard       Scoreboard?
  scoreboardStates ScoreboardState[]
}

model GameUser {
  id         String  @id @default(cuid())
  name       String
  gameId     String
  gameTeamId String?
  userId     String?
  token      String  @unique
  data       Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id])
  game     Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameTeam GameTeam? @relation(fields: [gameTeamId], references: [id], onDelete: Cascade)
}

enum BuzzerState {
  avilalble
  selected
  rejected
}

model GameTeam {
  id          String      @id @default(cuid())
  index       Int
  name        String
  gameId      String
  buzzerState BuzzerState @default(avilalble)
  data        Json        @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  game      Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameUsers GameUser[]

  @@unique([gameId, index])
}

model GameAdmin {
  id       String @id @default(cuid())
  userId   String
  gameId   String
  settings Json   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model ScoreboardState {
  id           String @id @default(cuid())
  gameId       String
  scoreboardId String
  state        Json   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  scoreboard       Scoreboard  @relation("AllScoreboardStates", fields: [scoreboardId], references: [id], onDelete: Cascade)
  activeScoreboard Scoreboard?
  game             Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model Scoreboard {
  id     String @id @default(cuid())
  gameId String @unique

  currentStateId String? @unique
  pastStateIds   Json    @default("[]")
  futureStateIds Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  game         Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  allStates    ScoreboardState[] @relation("AllScoreboardStates")
  currentState ScoreboardState?  @relation(fields: [currentStateId], references: [id])
}
